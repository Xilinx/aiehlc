//===----------------------------------------------------------------------===//
//
// Example IR demonstrating the dfschedule dialect usage pattern.
// This file shows the host-side configuration and kernel-side scheduling
// for a typical AIE dataflow application with ping-pong buffering.
//
//===----------------------------------------------------------------------===//

module {
   dfschedule.host_0 {
      %tensor = tensor.empty() : tensor<1024x1024xf32>
      %gmem = "dfschedule.declaretensor"(%tensor) : () -> memref<1024xf32>
      %shim0 = dfschedule.declaretile {col = 3, row = 0} : dfschedule.tile
      // bd_id, offset, packet_id and out_of_order_bd_id are SSA OPERANDS (i32),
      // not attributes -- they are per-tile values, so they are materialized as
      // arith.constant and passed positionally. linked_bd, when present, is the
      // optional LAST operand.
      %bd_id  = arith.constant 0 : i32
      %offset = arith.constant 0 : i32
      %pkt_id = arith.constant 10 : i32
      %ooo_bd = arith.constant -1 : i32
      %bd_config = dfschedule.config.dma_bd(%gmem, %shim0, %bd_id, %offset, %pkt_id, %ooo_bd) {
        len = 1024 : i32,
        enable_packet = true,
        next_bd = -1 : i32
      } : (memref<1024xf32>, !dfschedule.tile, i32, i32, i32, i32) -> !dfschedule.bd_handle

      %io_0 = "dfhost.config.create_io"(%bd_config0, %shim0) {
        channel = 0 : i32,
        direction = "MM2S",
        operation = "SEND"
      } : ( !dfhost.bdconfig_handle) -> !dfhost.io_handle

      // Launch kernel
      %core0 = dfschedule.declaretile {col = 0, row = 3} : dfschedule.tile
      %core1 = dfschedule.declaretile {col = 1, row = 3} : dfschedule.tile
      //%slice_0 = tensor.extract_slice %gmem[0, 4] [256, 1024] [1, 1] {tag = "partitionslice1"} : tensor<16x16xf32> to tensor<16x4xf32>
      %kernel_packet_0 = dfschedule.packet @packet0 (%gmem) {dma_channel=0}
      %kernel_packet_1 = dfschedule.packet @packet1 (%gmem) {dma_channel=0}
      %kernel_group = "dfschedule.config.load_kernel_group"(%core_0, %core_1) {
        callee = [@dskernel_receiver],
        distributed_args = [@packet0, @packet1],
      } : (!ds.tile, !ds.tile, tensor<4xi32>, i32) -> !dfschedule.kernelgroup
      %evt_kernel_group = "dfschedule.schedule.launch_kernel_group"(%kernel_group) {
      } : (dfschedule.kernelgroup) -> !ds.event
      
      // ============================================================
      // Step 3: Schedule - Runtime execution phase
      // ============================================================
      %bd_id = dfhost.schedule.getbdid(): arith.constant(i32)
      %evnt_io = "dfhost.schedule.start_io"(%io_0, %bd_id) : (!dfhost.io_handle) -> ()
      dfhost.schedule.wait(%evt_io, %evt_kernel_group)
    
  }
  
  dfschedule.dskernel.compute @compute0 ( %buf:memref<16x256xf32, "LOCAL">,%loop_count:arith.constant) -> compute {
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %rows = arith.constant 16 : index
      %cols = arith.constant 256 : index

      scf.for %r = %c0 to %rows step %c1 {
        scf.for %c = %c0 to %cols step %c1 {
          %v = memref.load %buf[%r, %c] : memref<16x256xf32, "LOCAL">
          %sq = arith.mulf %v, %v : f32
          memref.store %sq, %buf[%r, %c] : memref<16x256xf32, "LOCAL">
          scf.yield
        }
        scf.yield
      }
      return
  }

  // ============================================================
  // Kernel Function: Receiver with Ping-Pong Buffering
  // ============================================================
  dfschedule.dskernel_receiver(%arg0: packet, %computelogic:compute , %loop_count:arith:constant) {
    %input_tensor = dfschedule.gettensor(%arg0)
    %channel = dfschedule.getdmachannel(%arg0)
    
    // Allocate ping-pong buffers in shared local memory
    %ping = dfschedule.kernel.memalloc(%input_tensor) 
        : (tensor<16x256xf32>) -> memref<16x256xf32, "LOCAL">
  
    %pong = dfschedule.kernel.memalloc(%input_tensor) 
        : (tensor<16x256xf32>) -> memref<16x256xf32, "LOCAL">

    // Initialize locks for ping-pong synchronization
    // Acquire locks: signal when buffer is filled by DMA (0 = empty)
    // Release locks: signal when buffer is processed by compute (1 = ready for DMA)
    %0 = dskernel.lock_init(0, "ping_aquire_lock") -> !dskernel.lock
    %1 = dskernel.lock_init(0, "pong_aquire_lock") -> !dskernel.lock
    %2 = dskernel.lock_init(1, "ping_release_lock") -> !dskernel.lock
    %3 = dskernel.lock_init(0, "pong_release_lock") -> !dskernel.lock
    
    // ============================================================
    // DMA Thread: Runs in parallel with compute
    // ============================================================
    // The DMA waits for Release locks (buffer is free) and sets Acquire locks (buffer is full)
    "dskernel.launch_dma_s2m_loop"(%ping, %pong) {
      locks_ping = { acq=%l_ping_write, rel=%l_ping_read },
      locks_pong = { acq=%l_pong_write, rel=%l_pong_read },
      channelid = %channel
    } : (memref<16x256xf32, "SHARED">, memref<16x256xf32, "SHARED">) -> ()

    // ============================================================
    // Compute Loop: Ping-Pong computation pattern
    // ============================================================
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    
    scf.for %i = %c0 to %loop_count step %c1 {
      
      // --- A. Ping/Pong selection logic ---
      // Even iterations use Ping, odd iterations use Pong
      %is_ping = arith.cmpi "eq", arith.remui(%i, %c2), %c0 : index
      
      // Use scf.if to select the current buffer and locks
      %curr_buf, %curr_read_lock, %curr_write_lock = scf.if %is_ping 
        -> (memref<16x256xf32, "SHARED">, !dskernel.lock, !dskernel.lock) {
        scf.yield %ping, %l_ping_read, %l_ping_write
      } else {
        scf.yield %pong, %l_pong_read, %l_pong_write
      }

      // --- B. Acquire (wait for data) ---
      // Wait for DMA to fill the buffer (Read Lock -> 1)
      "dskernel.acquire_lock"(%curr_read_lock, 1)

      // --- C. Compute (core computation) ---
      // At this point, the tensor abstraction is gone; we operate on physical memref
      "core.compute"(%curr_buf,computelogic = %computelogic) : (memref<16x256xf32, "SHARED">) -> ()

      // --- D. Release (free buffer) ---
      // Return buffer to DMA (Write Lock -> 1)
      "dskernel.release_lock"(%curr_write_lock, 1)
    }
  
    return
  }
}